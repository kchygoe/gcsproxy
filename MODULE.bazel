module(
    name = "com_github_kchygoe_gcsproxy",
    version = "1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.8")
go_sdk.host()

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_fsouza_fake_gcs_server",
    "com_github_gorilla_mux",
    "com_google_cloud_go_auth",
    "com_google_cloud_go_storage",
    "org_golang_google_api",
)

bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
